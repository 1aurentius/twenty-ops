# Copy to .env.test before running the test stack. .env.test is git-ignored.
# These values are for an ISOLATED local test workspace ONLY — never used
# against a production Twenty workspace.

# Port the test Twenty server listens on. Pick something other than 3000
# (which usva-crm/deploy/ uses) if you run both stacks at once.
TWENTY_OPS_TEST_PORT=3001

# Public URL Twenty advertises to itself. Must match the port above.
SERVER_URL=http://localhost:3001

# Random string Twenty uses as the JWT / session secret. Any sufficiently
# long random value works for local testing.
APP_SECRET=test-only-app-secret-replace-with-something-random
