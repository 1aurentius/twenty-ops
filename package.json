{
  "name": "twenty-ops",
  "version": "0.7.0",
  "description": "Token-efficient CLI for managing a live Twenty CRM workspace (views, navigation, workflows) — built for command-line AI agents.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "twenty-ops": "./bin/twenty-ops.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:e2e": "vitest run test/e2e",
    "test:integration": "TWENTY_INTEGRATION=1 vitest run --no-file-parallelism test/integration",
    "test:drift": "TWENTY_INTEGRATION=1 vitest run test/integration/schema-drift.int.test.ts",
    "test:up": "cp -n deploy/.env.test.example deploy/.env.test 2>/dev/null; docker compose -f deploy/docker-compose.yml --env-file deploy/.env.test up -d && tsx scripts/seed-test-workspace.ts",
    "test:down": "docker compose -f deploy/docker-compose.yml --env-file deploy/.env.test stop",
    "test:wipe": "docker compose -f deploy/docker-compose.yml --env-file deploy/.env.test down -v",
    "snapshot:schema": "tsx scripts/snapshot-schema.ts",
    "check": "npm run typecheck && npm test",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
